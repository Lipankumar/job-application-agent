NODE_ENV=development
OPENROUTER_API_KEY=
BROWSER_CHANNEL=chrome
# Optional: reuse your existing Chrome profile (close Chrome before running).
# For the project-managed profile, use ./data/browser-profile
BROWSER_USER_DATA_DIR=./data/browser-profile

# Job platforms (set to false to skip a platform)
ENABLE_NAUKRI=true
ENABLE_HIRIST=true
ENABLE_INDEED=true
ENABLE_INSTAHYRE=true
ENABLE_OLDER_JOBS=false

# Instahyre account credentials (email can also fall back to CANDIDATE_EMAIL)
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=
INSTAHYRE_MATCH_THRESHOLD=70

# Candidate personal and professional details
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LOCATION=
CANDIDATE_EXPERIENCE_YEARS=
CANDIDATE_EXPERIENCE_LEVEL=
CANDIDATE_CURRENT_ROLE=
CANDIDATE_CURRENT_COMPANY=
CANDIDATE_PRIMARY_DOMAIN=
CANDIDATE_NOTICE_PERIOD_DAYS=
CANDIDATE_CURRENTLY_SERVING_NOTICE=

# Job board credentials
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
